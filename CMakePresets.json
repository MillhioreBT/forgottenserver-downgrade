{
	"version": 3,
	"configurePresets": [
		{
			"name": "default",
			"description": "Generate Ninja project files",
			"binaryDir": "${sourceDir}/build"
		},
		{
			"name": "vcpkg",
			"inherits": [
				"default"
			],
			"description": "Configure with vcpkg toolchain and generate Ninja project files",
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
		},
		{
			"name": "test",
			"description": "Debug build with the unit tests, dependencies from the system (e.g. apt)",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/test",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"BUILD_TESTING": "ON",
				"SKIP_GIT": "ON"
			}
		},
		{
			"name": "test-vcpkg",
			"inherits": [
				"test"
			],
			"description": "Debug build with the unit tests, dependencies from vcpkg",
			"binaryDir": "${sourceDir}/build/test-vcpkg",
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
		}
	],
	"buildPresets": [
		{
			"name": "default",
			"configurePreset": "default"
		},
		{
			"name": "vcpkg",
			"configurePreset": "vcpkg"
		},
		{
			"name": "test",
			"configurePreset": "test",
			"targets": [
				"tfs_tests"
			]
		},
		{
			"name": "test-vcpkg",
			"configurePreset": "test-vcpkg",
			"targets": [
				"tfs_tests"
			]
		}
	],
	"testPresets": [
		{
			"name": "default",
			"configurePreset": "default"
		},
		{
			"name": "vcpkg",
			"configurePreset": "vcpkg"
		},
		{
			"name": "test",
			"configurePreset": "test",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "test-vcpkg",
			"configurePreset": "test-vcpkg",
			"output": {
				"outputOnFailure": true
			}
		}
	]
}
